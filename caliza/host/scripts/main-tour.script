# Caliza Estratos scripted controller tour. Paths are relative to the caller's working directory.
shot @OUT@/00-boot.png
wait 1400
expect-screen home
shot @OUT@/01-home.png
press cross
expect-screen library
shot @OUT@/02-library-filters.png
press right
shot @OUT@/03-library-grid.png
press triangle
shot @OUT@/04-search-keyboard.png
press circle
press square
expect-screen game-detail
shot @OUT@/05-game-detail.png
press cross
wait 250
press options
wait 100
expect-screen pause
shot @OUT@/06-pause-overlay.png
press circle
press circle
press circle
expect-screen home
shot @OUT@/01b-home-continue.png
# Memory Cards (continue now occupies index zero. Up clamps there).
press up
press up
press up
press up
press up
press up
press down
press down
press cross
expect-screen memory-cards
shot @OUT@/07-memory-cards.png
press circle
# Settings.
press up
press up
press up
press up
press up
press up
press down
press down
press down
press cross
